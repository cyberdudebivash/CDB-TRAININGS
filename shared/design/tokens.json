  "pairs": [
    {"fg": "text", "bg": "bg", "min": 7.0, "use": "body text (AAA)"},
    {"fg": "text", "bg": "surface", "min": 7.0, "use": "text on panels"},
    {"fg": "muted", "bg": "bg", "min": 4.5, "use": "secondary text"},
    {"fg": "muted", "bg": "surface", "min": 4.5, "use": "secondary text on panels"},
    {"fg": "primary", "bg": "bg", "min": 4.5, "use": "links"},
    {"fg": "primary", "bg": "surface", "min": 4.5, "use": "links on panels"},
    {"fg": "primary_on", "bg": "primary", "min": 4.5, "use": "buttons / badges"},
    {"fg": "success", "bg": "bg", "min": 4.5, "use": "status text"},
    {"fg": "warning", "bg": "bg", "min": 4.5, "use": "status text"},
    {"fg": "danger", "bg": "bg", "min": 4.5, "use": "status text"},
    {"fg": "code_text", "bg": "code_bg", "min": 7.0, "use": "code blocks"},
    {"fg": "border", "bg": "bg", "min": 3.0, "use": "UI component boundaries (WCAG 1.4.11)"}
  ]
