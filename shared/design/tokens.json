{
  "name": "CDB Academy design tokens",
  "version": "0.1.0",
  "wcag_target": "2.2 AA",
  "light": {
    "bg": "#ffffff",
    "surface": "#f4f6f8",
    "text": "#1b1f24",
    "muted": "#4a5560",
    "primary": "#0b5cad",
    "primary_on": "#ffffff",
    "success": "#1a6b30",
    "warning": "#8a4b00",
    "danger": "#a4262c",
    "border": "#8c959f",
    "code_bg": "#eef1f4",
    "code_text": "#1b1f24"
  },
  "dark": {
    "bg": "#0d1117",
    "surface": "#161b22",
    "text": "#e6edf3",
    "muted": "#a3afbb",
    "primary": "#6cb2ff",
    "primary_on": "#0d1117",
    "success": "#56d364",
    "warning": "#e3a008",
    "danger": "#ff7b72",
    "border": "#6e7781",
    "code_bg": "#1c2128",
    "code_text": "#e6edf3"
